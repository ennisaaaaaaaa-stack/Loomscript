{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Loomscript Bundle Contract v0",
  "description": "剧本包合同——生成模块的输出、游玩模块的输入。前后端只认此合同，互不 import。内容层可由咖啡侧剧本替换，结构不变。",
  "type": "object",
  "required": ["id", "title", "version", "characters", "acts", "props", "endgame"],
  "properties": {
    "id": {"type": "string", "description": "剧本包唯一标识，如 macbeth-demo"},
    "title": {"type": "string"},
    "version": {"type": "string"},
    "language": {"type": "string", "default": "zh"},
    "characters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "public_sheet"],
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "is_player": {"type": "boolean", "default": false, "description": "玩家角色 vs AI 演员"},
          "public_sheet": {"type": "string", "description": "公开角色本（玩家可见）"},
          "secret_sheet": {"type": "string", "description": "私密角色本（agent 视角/真相层，防剧透隔离）"},
          "voice": {"type": "string", "description": "说话风格提示"}
        }
      }
    },
    "acts": {
      "type": "array",
      "minItems": 1,
      "description": "幕结构。AI 演员只持有到当前幕为止的上下文（第三幕=前三幕世界信息+角色本前三幕）",
      "items": {
        "type": "object",
        "required": ["act_id", "title", "world_info", "scenes"],
        "properties": {
          "act_id": {"type": "string"},
          "title": {"type": "string"},
          "world_info": {"type": "string", "description": "本幕世界信息"},
          "scenes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["scene_id", "text"],
              "properties": {
                "scene_id": {"type": "string"},
                "text": {"type": "string", "description": "场景叙述"},
                "image_id": {"type": "string", "description": "场景配图 id，指向 bundle.assets 列表；无图场景可省略"},
                "choices": {
                  "type": "array",
                  "description": "可选分支；空=自由对话推进",
                  "items": {
                    "type": "object",
                    "required": ["id", "label"],
                    "properties": {
                      "id": {"type": "string"},
                      "label": {"type": "string"},
                      "leads_to": {"type": "string", "description": "目标 scene_id"}
                    }
                  }
                },
                "reveals": {
                  "type": "array",
                  "description": "本幕揭示的真相，揭示后写入对应角色的已解锁知识",
                  "items": {"type": "string"}
                }
              }
            }
          }
        }
      }
    },
    "props": {
      "type": "array",
      "description": "道具与CG在开局预生成、放固定位置（预生成哲学）",
      "items": {
        "type": "object",
        "required": ["id", "name", "act_introduced"],
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "act_introduced": {"type": "string", "description": "首次出现幕 act_id"},
          "cg_id": {"type": "string", "description": "关联结局CG/道具槽位（收集最小集）"}
        }
      }
    },
    "cards": {
      "type": "array",
      "description": "象征卡牌（塔罗类）——v1 内置趣味玩法",
      "items": {
        "type": "object",
        "required": ["id", "name", "symbol"],
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "symbol": {"type": "string"}
        }
      }
    },
    "assets": {
      "type": "array",
      "description": "预生成资产清单（图片等），开局前已生成完毕，对局中只按 id 引用。scene.image_id / props.cg_id / cards 的卡面均指向此表",
      "items": {
        "type": "object",
        "required": ["id", "kind", "uri"],
        "properties": {
          "id": {"type": "string"},
          "kind": {"type": "string", "enum": ["scene_image", "cg", "card_art", "prop_icon"]},
          "uri": {"type": "string", "description": "相对路径或 URL"},
          "prompt": {"type": "string", "description": "生成提示词（审计用，可省）"}
        }
      }
    },
    "actor_turns": {
   "type": "object",
   "description": "逐轮演员包按幕分桶：{act_id: {role_id: [cue,...]}}，外加 _meta 审计项（cue 总数/来源，不参与装配）。cue 天然归属剧情事件（event 前缀即幕号），DM 装配按当前幕切片——未来幕的包物理不进角色材料（数据结构级防剧透，同 secret_sheet 切片思路）。cue 的逐轮派发（选轮+送达回执）是运行时行为，bundle 只携带静态包",
   "patternProperties": {
    "^_meta$": {
     "type": "object",
     "description": "审计元数据（cue_count/source），装配侧不读"
    },
    "^(?!_meta$).+$": {
     "type": "object",
     "description": "一个幕的桶：{role_id: [cue,...]}",
     "additionalProperties": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "object",
       "required": [
        "cue_id",
        "event",
        "tick",
        "pack"
       ],
       "properties": {
        "cue_id": {
         "type": "string",
         "description": "cue 标识，如 U004 / CUE_WH01"
        },
        "event": {
         "type": "string",
         "description": "剧情事件 id，如 a1_prophecy（前缀=幕号）"
        },
        "tick": {
         "type": "integer",
         "description": "事件内派发顺序（素材内部 tick，仅排序用）"
        },
        "status": {
         "type": "string",
         "description": "演员状态，如 active"
        },
        "recipient_role_id": {
         "type": [
          "string",
          "null"
         ],
         "description": "私下表达的对象；null=公开台词"
        },
        "requires_fact_ids": {
         "type": "array",
         "items": {
          "type": "string"
         },
         "description": "该 cue 派发前必须已送达的事实 id（投放规则V3）"
        },
        "pack": {
         "type": "object",
         "required": [
          "self_profile",
          "confirmed_knowledge",
          "own_lines",
          "current_goal",
          "visible_clues",
          "visible_prop_pages"
         ],
         "description": "演员包本体（内容层，内部中文 key 原样保留）：self_profile=角色卡（公开面/秘密面/驱动/底线/行为边界/语气指纹）、confirmed_knowledge=已送达回执事实、own_lines=本轮获准台词、current_goal=本轮目标、visible_clues/visible_prop_pages=可见线索与道具页",
         "properties": {
          "self_profile": {
           "type": "object"
          },
          "confirmed_knowledge": {
           "type": "array"
          },
          "own_lines": {
           "type": "array"
          },
          "current_goal": {
           "type": "string"
          },
          "visible_clues": {
           "type": "array"
          },
          "visible_prop_pages": {
           "type": "array"
          }
         }
        }
       }
      }
     }
    }
   }
  },
  "endgame": {
      "type": "object",
      "required": ["conditions", "review_prompt"],
      "properties": {
        "conditions": {
          "type": "array",
          "description": "结局判定条件（评价系统=纯 demo 数据）",
          "items": {
            "type": "object",
            "required": ["id", "description"],
            "properties": {
              "id": {"type": "string"},
              "description": {"type": "string"},
              "cg_id": {"type": "string"}
            }
          }
        },
        "review_prompt": {"type": "string", "description": "复盘引导：DM 总结+自由交流+进对局记忆"}
      }
    },
    "deaths": {
      "type": "array",
      "description": "死亡定义表（数据驱动、确定性）。引擎进入 scene.deaths 所列场景时按 id 触发 death 事件并翻转状态位；无随机、无时间触发，重放一致",
      "items": {
        "type": "object",
        "required": ["id", "character_id", "act_id", "scene_id", "description"],
        "properties": {
          "id": {"type": "string", "description": "死亡定义唯一 key，death 事件以 death_id 引用"},
          "character_id": {"type": "string", "description": "死者角色 id（须在 characters 表内）"},
          "act_id": {"type": "string", "description": "死亡发生幕"},
          "scene_id": {"type": "string", "description": "死亡发生场景——进入该场景即触发（对应原作节拍）"},
          "description": {"type": "string", "description": "死亡叙述（death 事件 text，观演者与复盘可见）"},
          "observer_brief": {"type": "string", "description": "死后观演视角简报：转观察者后以什么身份看戏（可省，缺省用通用观演词）"}
        }
      }
    }
  }
}
